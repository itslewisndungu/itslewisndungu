---
export const prerender = false;

import { Image } from "astro:assets";
import SpotifyLogo from "../../assets/images/logos/spotify.svg";
import SimpleLayout from "../../components/SimpleLayout.astro";
import Artwork from "../../components/spotify/SpotifyArtwork.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getNowPlaying,
  NOW_PLAYING_CACHE_CONTROL,
  type NowPlaying,
} from "../../lib/spotify";

let nowPlaying: NowPlaying | null = null;
let failed = false;

try {
  nowPlaying = await getNowPlaying();
} catch (error) {
  console.error(error);
  failed = true;
}

Astro.response.headers.set(
  "Cache-Control",
  failed ? "no-store" : NOW_PLAYING_CACHE_CONTROL,
);
---

<Layout
  title="What am I listening to?"
  description="I love all kinds of music. Here’s a glimpse of what I’m listening to right now, mostly on Spotify."
>
  <SimpleLayout
    title="What am I listening to?"
    intro="I listen to music all the time, whether I’m working, cleaning or cooking, you name it. Here’s what I’m listening to right now."
  >
    <!-- Both states are always rendered so the client script can switch between them. -->
    <div
      data-now-playing
      data-initial={JSON.stringify(nowPlaying)}
      data-failed={failed ? "" : undefined}
    >
      <div
        hidden={!nowPlaying}
        class="group flex items-start gap-5 md:gap-10 rounded-2xl px-2 py-4 md:px-4"
        data-now-playing-card
      >
        <Artwork nowPlaying={nowPlaying} />

        <a
          href={nowPlaying?.songUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="overflow-hidden"
          data-field="link"
        >
          <Image
            height={82}
            width={300}
            class={"h-5 md:h-7 w-auto mt-2 md:mt-10"}
            src={SpotifyLogo}
            alt="Spotify Logo"
          />

          <p
            class="mt-2 md:mt-5 text-xs font-medium tracking-wide text-spotify-green uppercase"
            data-field="status"
          >
            {nowPlaying?.isPlaying ? "Now playing" : "Paused"}
          </p>

          <p
            class="mt-1 truncate text-base md:text-xl font-semibold text-zinc-800 group-hover:text-spotify-green dark:text-zinc-100"
            data-field="title"
          >
            {nowPlaying?.title}
          </p>

          <p
            class="mt-0.5 text-pretty text-sm md:text-lg text-zinc-600 dark:text-zinc-400 text"
            data-field="artist"
          >
            {nowPlaying?.artist}
          </p>
        </a>
      </div>

      <p
        hidden={!!nowPlaying}
        class="text-base text-zinc-600 dark:text-zinc-400"
        data-now-playing-empty
      >
        Not listening to anything right now. Check back later.
      </p>
    </div>
  </SimpleLayout>
</Layout>

<script>
import { initNowPlaying } from "../../lib/nowPlaying";

// Module scripts run once, so re-initialise against each page's fresh DOM.
document.addEventListener("astro:page-load", () => {
  const cleanupNowPlaying = initNowPlaying();

  document.addEventListener("astro:before-swap", () => cleanupNowPlaying?.(), {
    once: true,
  });
});
</script>
