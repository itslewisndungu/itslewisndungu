---
import { Image } from "astro:assets";
import image5 from "../assets/images/photos/fourteen-falls.jpg";
import image3 from "../assets/images/photos/jahazii-playful.png";
import image4 from "../assets/images/photos/malindi-sunset.jpg";
import image2 from "../assets/images/photos/ngong-sunkissed.jpg";
import image1 from "../assets/images/photos/olonongot.jpg";
import Container from "../components/Container.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import LinkedInIcon from "../components/icons/LinkedInIcon.astro";
import Layout from "../layouts/Layout.astro";

const socialLinks = [
  {
    href: "https://github.com/itslewisndungu",
    label: "Follow on GitHub",
    icon: GitHubIcon,
  },
  {
    href: "https://www.linkedin.com/in/itslewisndungu",
    label: "Follow on LinkedIn",
    icon: LinkedInIcon,
  },
];

const photos = [
  {
    src: image1,
    alt: "Lewis sitting on the Mt Longonot summit sign with his arms spread over the Rift Valley",
  },
  {
    src: image2,
    alt: "Lewis and two friends in golden evening light by the wind turbines on the Ngong Hills",
  },
  {
    src: image3,
    alt: "Lewis laughing with his arms crossed, wearing a black Jahazii T-shirt",
  },
  {
    src: image4,
    alt: "Silhouette of Lewis watching the sunset over the water in Malindi",
  },
  {
    src: image5,
    alt: "Lewis raising a fist in front of Fourteen Falls",
  },
];

const rotations = [
  "rotate-2",
  "-rotate-2",
  "rotate-2",
  "rotate-2",
  "-rotate-2",
];
---

<Layout>
  <Container class="mt-9">
    <div class="max-w-2xl">
      <h1
        class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100 text-pretty"
      >
        Software engineer, amateur cyclist and hiker.
      </h1>
      <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400">
        I’m Lewis, a software engineer based in Nairobi, Kenya. Welcome to my
        personal website, where you get to peer a bit into my life, my thoughts
        and some of my work. The site is still a work in progress, and I hope
        something cool comes out of it 🙃.
      </p>
      <div class="mt-6 flex gap-6">
        {socialLinks.map(({ href, label, icon: Icon }) => (
          <a href={href} aria-label={label} class="group -m-1 p-1">
            <Icon class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300" />
          </a>
        ))}
      </div>
    </div>
  </Container>

  <!-- Photos -->
  <div class="mt-16 sm:mt-20">
    <div class="-my-4 flex justify-center gap-5 overflow-hidden py-4 sm:gap-8">
      {photos.map((photo, photoIndex) => (
        <div
          class:list={[
            "relative w-44 flex-none overflow-hidden rounded-xl bg-zinc-100 sm:w-72 sm:rounded-2xl dark:bg-zinc-800",
            rotations[photoIndex % rotations.length],
          ]}
        >
          <div class="aspect-9/10">
            <Image
              src={photo.src}
              alt={photo.alt}
              width={576}
              widths={[176, 288, 352, 576]}
              sizes="(min-width: 640px) 18rem, 11rem"
              loading="eager"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
